{
  "realm": "practics",
  "enabled": true,
  "displayName": "Practics",
  "displayNameHtml": "<strong>Practics</strong>",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator"
      },
      {
        "name": "user",
        "description": "Regular user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "frontend",
      "name": "Frontend",
      "description": "SPA (Vite + React) public client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:9000",
      "baseUrl": "http://localhost:9000",
      "redirectUris": ["http://localhost:9000/*"],
      "webOrigins": ["http://localhost:9000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9000/*"
      }
    },
    {
      "clientId": "backend",
      "name": "Backend",
      "description": "NestJS resource server (bearer-only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@practics.local",
      "firstName": "Admin",
      "lastName": "Practics",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "email": "user@practics.local",
      "firstName": "User",
      "lastName": "Practics",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}
